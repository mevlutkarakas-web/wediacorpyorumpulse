DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yorum_pulse?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/yorum_pulse?schema=public"
JWT_SECRET="generate-a-random-secret-with-at-least-32-characters"
YOUTUBE_API_KEY=""
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_GRAPH_API_VERSION="v24.0"
FACEBOOK_SESSION_COOKIES=""
FACEBOOK_BROWSER_HEADLESS="true"
# Boş bırakılırsa Chrome/Edge/Chromium bilinen yollarda aranır (macOS/Linux/Windows).
FACEBOOK_BROWSER_PATH=""
# Konteynerde root olarak çalışırken gerekli.
FACEBOOK_BROWSER_NO_SANDBOX="false"
# Tek tarama için süre bütçesi ve eşzamanlı tarama sayısı (Chromium paylaşımlı).
FACEBOOK_SCRAPE_BUDGET_MS="900000"
FACEBOOK_SCRAPE_SLOTS="1"
FACEBOOK_MAX_GRAPH_PAGES="20"
# Worker doğrudan veritabanına yazıyorsa BOŞ BIRAKIN: mirror gereksiz bir çift
# yazma yolu ve eksik taramada yorumları kalıcı silebiliyor.
FACEBOOK_COMMENT_MIRROR_URL=""
FACEBOOK_COMMENT_MIRROR_EMAIL=""
FACEBOOK_COMMENT_MIRROR_PASSWORD=""
# --- Worker (arka plan senkronizasyon süreci) ---
# Web ile aynı veritabanı, ama havuzu eşzamanlılığa göre boyutlandırılmış.
# Boyut = WORKER_CONCURRENCY + 6. Supabase pooler'ı (6543) kullanılıyorsa &pgbouncer=true ekle.
WORKER_DATABASE_URL=""
SYNC_INTERVAL_MINUTES="15"
WORKER_CONCURRENCY="4"
WORKER_ANALYZE_SLOTS="2"
WORKER_HEARTBEAT_MS="30000"
WORKER_LOCK_TTL_MS="180000"
WORKER_SWEEP_MS="60000"
WORKER_DRAIN_MS="25000"
# Kuyruk devre kesicileri: eşik aşılırsa yeni iş üretilmez.
MAX_PENDING_BACKLOG="4000"
MAX_PENDING_COMMENT_JOBS="2000"
# Artımlı senkron pencereleri
VIDEO_HOT_WINDOW_HOURS="48"
COMMENT_RESYNC_HOURS="168"
# İş saklama süresi (budama)
JOB_RETENTION_COMPLETED_HOURS="24"
JOB_RETENTION_FAILED_DAYS="14"
# Kota planlaması
YOUTUBE_QUOTA_LIMIT="10000"
YOUTUBE_QUOTA_RESERVE="0.85"
EST_UNITS_PER_CHANNEL="8"
# Çoklu worker çalıştırılırsa yalnızca birinde planlayıcı açık kalsın.
SCHEDULER_ENABLED="true"
BOOTSTRAP_ADMINS_JSON="[]"
TEAM_DEFAULT_PASSWORD=""
TEAM_EMAIL_MAP_JSON="{}"
REMINDER_EMAILS=""
REMINDER_SEND_HOUR="9"
MAX_VIDEOS_PER_CHANNEL="500"
MAX_COMMENTS_PER_VIDEO="2000"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
REMINDER_FROM=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"
AI_PROVIDER="AUTO"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
AI_SETTINGS_ENCRYPTION_KEY=""
CRON_SECRET="generate-a-separate-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
